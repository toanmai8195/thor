module(
    name = "thor",
    version = "1.0.0",
)

# =============================================================================
# BAZEL DEPENDENCIES
# =============================================================================
# Đây là file cấu hình Bazel với bzlmod (Bazel 6+)
#
# LƯU Ý: Project này pin Bazel 8.7.0 qua .bazelversion (giống vision; rules_js 3.x cần ≥ 8.1).
# rules_oci + tar.bzl chưa tương thích với Bazel 9.
#
# CÁCH CẬP NHẬT:
# - Go:   sửa go.mod → bazel run //:gazelle
# - Node/TS: sửa package.json → pnpm install (cập nhật pnpm-lock.yaml)
# =============================================================================

# =============================================================================
# CORE
# =============================================================================
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")

# =============================================================================
# GO RULES
# =============================================================================
bazel_dep(name = "rules_go", version = "0.53.0")
bazel_dep(name = "gazelle", version = "0.42.0")

# Go SDK
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.22.0")

# Go dependencies từ go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_google_uuid",
    "com_github_ibm_sarama",
)

# =============================================================================
# NODE.JS / TYPESCRIPT RULES
# =============================================================================
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "rules_nodejs", version = "6.7.5")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.22.3")

# npm deps của friend-service từ pnpm-lock.yaml → @npm_friend_service
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_friend_service",
    pnpm_lock = "//com/tm/friend-service:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm_friend_service")

# TypeScript: ts_project biên dịch + typecheck; version tsc lấy từ package.json
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript")
typescript.deps(version_from = "//com/tm/friend-service:package.json")
use_repo(typescript, "npm_typescript")

# =============================================================================
# OCI / CONTAINER RULES
# =============================================================================
bazel_dep(name = "rules_oci", version = "2.2.6")
bazel_dep(name = "tar.bzl", version = "0.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    digest = "sha256:611d30d7f6d9992c37b1e1a212eefdf1f7c671deb56db3707e24eb01da8c4c2a",
    image = "gcr.io/distroless/base",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
)

# Node.js: js_binary launcher là bash script, node cần glibc + libstdc++ → debian slim
oci.pull(
    name = "node_base",
    digest = "sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251",
    image = "docker.io/library/debian",
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "bookworm-slim",
)

use_repo(
    oci,
    "distroless_base",
    "distroless_base_linux_amd64",
    "distroless_base_linux_arm64_v8",
    "node_base",
    "node_base_linux_amd64",
    "node_base_linux_arm64_v8",
)
