# =============================================================================
# BUILD FILE - ANALYTICS AGGREGATOR (CDP Medallion Pipeline)
# =============================================================================

filegroup(
    name = "cdp_dag_files",
    srcs = glob(["cdp/dags/*.py"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dbt_silver_files",
    srcs = glob(
        ["cdp/dbt_silver/**/*.sql", "cdp/dbt_silver/**/*.yml", "cdp/dbt_silver/**/*.yaml"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dbt_gold_files",
    srcs = glob(
        ["cdp/dbt_gold/**/*.sql", "cdp/dbt_gold/**/*.yml", "cdp/dbt_gold/**/*.yaml"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dbt_realtime_files",
    srcs = glob(
        ["cdp/dbt_realtime/**/*.sql", "cdp/dbt_realtime/**/*.yml", "cdp/dbt_realtime/**/*.yaml"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)
