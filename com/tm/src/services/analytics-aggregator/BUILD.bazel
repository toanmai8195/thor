# =============================================================================
# BUILD FILE - ANALYTICS AGGREGATOR (CDP Medallion Pipeline)
# =============================================================================
# Targets:
#   bazel test :dag_validation_test   → validate CDP DAG syntax
# =============================================================================

load("@rules_python//python:defs.bzl", "py_library", "py_test")

py_library(
    name = "cdp_dags_lib",
    srcs = glob(["cdp/dags/*.py"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dag_files",
    srcs = glob(["cdp/dags/*.py"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dbt_silver_files",
    srcs = glob(
        ["cdp/dbt_silver/**/*.sql", "cdp/dbt_silver/**/*.yml", "cdp/dbt_silver/**/*.yaml"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "cdp_dbt_gold_files",
    srcs = glob(
        ["cdp/dbt_gold/**/*.sql", "cdp/dbt_gold/**/*.yml", "cdp/dbt_gold/**/*.yaml"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
)

py_test(
    name = "dag_validation_test",
    srcs = ["tests/test_dag_validation.py"],
    main = "tests/test_dag_validation.py",
    deps = [":cdp_dags_lib"],
    data = [":cdp_dag_files"],
)
