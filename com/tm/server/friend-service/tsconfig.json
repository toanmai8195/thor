{
  // Dùng chung cho Bazel (ts_project) và dev local (pnpm typecheck).
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
